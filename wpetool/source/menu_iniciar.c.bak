static volatile unsigned g_lastWp = 0;

/* Diagnostico desenhado na barra de tarefas (lido na captura de tela) */
static HWND g_hwndTaskbar;                 /* declaracao antecipada (def. abaixo) */
static char g_dbg[96] = "boot";
static void DbgSet(const char *s) {
    lstrcpynA(g_dbg, s, 96);
    if (g_hwndTaskbar) InvalidateRect(g_hwndTaskbar, NULL, FALSE);
}

/* Equivalentes de PathFileExists / PathIsDirectory sem depender de shlwapi */
static BOOL ExpPathExists(const WCHAR *p) {
    return p && p[0] && GetFileAttributesW(p) != INVALID_FILE_ATTRIBUTES;
}
static BOOL ExpPathIsDir(const WCHAR *p) {
    DWORD a = p ? GetFileAttributesW(p) : INVALID_FILE_ATTRIBUTES;
    return (a != INVALID_FILE_ATTRIBUTES) && (a & FILE_ATTRIBUTE_DIRECTORY) != 0;
}

