/* Um item (ficheiro, pasta ou unidade). "name" e o rotulo visivel,
   "path" o caminho real usado na navegacao. */
typedef struct {
    WCHAR name[MAX_PATH];
    WCHAR path[MAX_PATH];
    DWORD attrs;
    ULARGE_INTEGER size;
    FILETIME ft;
    BOOL isDir;
    BOOL isDrive;
} EXPITEM;

/* Estado de cada janela do explorador */
typedef struct {
    WCHAR path[MAX_PATH];
    WCHAR hist[64][MAX_PATH];
    int histCount, histPos;
    EXPITEM *items;      /* conteudo da pasta atual */
    int nItems, capItems;
    BOOL drivesMode;
    EXPITEM *places;     /* locais da barra lateral */
    int nPlaces, capPlaces;
    int cascade;
} EXPLORER;

/* Comando interno: abrir o explorador de arquivos do proprio programa */
#define CMD_EXPLORER  L"#explorer"

